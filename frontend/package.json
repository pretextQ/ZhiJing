{
  "name": "zhijing-study-room",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lucide/vue": "^1.73",
    "pinia": "^4.1.0",
    "vue": "^3.5",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^7",
    "vitest": "^5.1.0",
    "vue-tsc": "^3"
  }
}
