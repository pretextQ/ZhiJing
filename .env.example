ZHIJING_AI_BASE_URL=http://127.0.0.1:18082/v1
ZHIJING_AI_MODEL=synthetic-python
ZHIJING_AI_API_KEY=synthetic-local-key
ZHIJING_AI_MAX_TOKENS=8192
ZHIJING_AI_TEMPERATURE=0.4
ZHIJING_AI_ROUND_TIMEOUT=270
ZHIJING_AI_MIN_CHUNK_TIME=30

# Defaults to .data/study.sqlite3. Point the Obsidian setting at an existing subfolder.
# ZHIJING_STUDY_DATABASE=.data/study.sqlite3
# ZHIJING_STUDY_OBSIDIAN_DIR=
# Data directory for SQLite, imported themes and backups. Defaults to the database folder.
# ZHIJING_STUDY_DATA_DIR=.data
# Imported theme packs default to <data directory>/themes.
# ZHIJING_STUDY_THEME_DIR=.data/themes
# Theme pack limits (archive MiB, expanded MiB, entry count).
# ZHIJING_STUDY_THEME_MAX_ARCHIVE_MB=32
# ZHIJING_STUDY_THEME_MAX_EXPANDED_MB=64
# ZHIJING_STUDY_THEME_MAX_ENTRIES=32
